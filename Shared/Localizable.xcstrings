          }
        }
      }
    },
    "핸드폰이 스팀기 근처에 위치해있는지, 외부소리가 너무 큰 것은 아닌지 확인해주세요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that your phone is near the steam wand and that background noise isn't too loud."
          }
