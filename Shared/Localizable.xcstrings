    "거품 두께를 직접 살펴보세요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the foam's thickness yourself"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거품 두께를 직접 살펴보세요"
          }
        }
      }
    },
    "거품 사이에 큰 기포가\n남았을 수 있어요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large bubbles may\nremain in the foam"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거품 사이에 큰 기포가\n남았을 수 있어요"
          }
        }
      }
    },
    "거품이 우유와 덜 섞여\n위에 남았을 수 있어요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some foam may have\nstayed on top"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거품이 우유와 덜 섞여\n위에 남았을 수 있어요"
          }
        }
      }
    },
    "거품이 원하는 만큼 생겼나요?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is the foam as thick as you wanted?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거품이 원하는 만큼 생겼나요?"
          }
        }
      }
    },
    "거품이 조금\n얇을 수 있어요": {
      "extractionState": "manual",
      "localizations": {
