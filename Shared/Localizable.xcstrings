{
  "sourceLanguage": "ko",
  "strings": {
    "\n\n\n---\n앱 버전: %@\n기기: %@ · iOS %@\n": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n\n---\nApp version: %@\nDevice: %@ · iOS %@\n"
