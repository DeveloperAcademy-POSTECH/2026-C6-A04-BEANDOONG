            "state": "translated",
            "value": "HomeWatchPractice"
          }
        }
      }
    },
    "iPhone 앱을 열어주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please open the iPhone app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 앱을 열어주세요."
          }
        }
      }
    },
    "iPhone에서 마이크 권한을 허용해주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please allow microphone access on your iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 마이크 권한을 허용해주세요."
          }
        }
      }
    },
    "iPhone에서 연습은 계속 진행돼요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practice continues on your iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 연습은 계속 진행돼요"
          }
        }
      }
    },
    "iPhone에서 연습을 시작하고 있어요. 잠시 기다려주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practice is starting on your iPhone. Please wait a moment."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 연습을 시작하고 있어요. 잠시 기다려주세요."
          }
        }
      }
    },
    "iPhone에서 워치 없이 연습 중이에요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're practicing on iPhone without your watch."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 워치 없이 연습 중이에요."
          }
        }
      }
    },
    "iPhone의 Watch 앱에서\nApple Watch의 페어링 상태를 확인해주세요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your Apple Watch pairing\nin the Watch app on your iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone의 Watch 앱에서\nApple Watch의 페어링 상태를 확인해주세요"
          }
        }
      }
    },
    "iPhone의 Watch 앱에서\nchic을 찾아 설치해주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find and install chic in the\nWatch app on your iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone의 Watch 앱에서\nchic을 찾아 설치해주세요."
          }
        }
      }
    },
    "같은 경고 상태": {
      "extractionState": "manual",
      "localizations": {
