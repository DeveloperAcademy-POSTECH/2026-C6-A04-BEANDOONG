    "공기 주입 소리가 감지되는 동안\n 화면 속 우유가 서서히 차올라요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The milk on screen rises gradually\nwhile we detect aeration sounds."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공기 주입 소리가 감지되는 동안\n 화면 속 우유가 서서히 차올라요"
          }
        }
      }
    },
    "공기 주입 시간을\n잘 맞췄어요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your aeration time\nwas on track"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공기 주입 시간을\n잘 맞췄어요"
          }
        }
      }
    },
    "공기 주입에 따라\n우유가 차올라요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
