    "최신 버전 사용중": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're up to date"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신 버전 사용중"
          }
        }
      }
    },
    "취소": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소"
          }
        }
      }
    },
    "컵에 따른 뒤 거품이 원했던 것보다 두껍게 쌓였는지 보세요. 더 얇은 거품을 원한다면 다음엔 공기 주입을 조금 일찍 마쳐 보세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After pouring, check whether the foam is thicker than you wanted. For thinner foam, try finishing aeration a little earlier next time."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컵에 따른 뒤 거품이 원했던 것보다 두껍게 쌓였는지 보세요. 더 얇은 거품을 원한다면 다음엔 공기 주입을 조금 일찍 마쳐 보세요."
          }
        }
      }
    },
    "컵에 따를 때 묽은 우유가 먼저 나오고 거품이 피처에 덩어리로 남는다면, 우유와 거품이 덜 섞인 거예요. 다음엔 공기를 넣은 뒤 노즐 끝을 살짝 담가 우유 전체가 돌도록 해 보세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If thin milk pours first and clumps of foam stay in the pitcher, they haven't mixed evenly. Next time, after adding air, submerge the tip slightly so the whole pitcher of milk swirls."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컵에 따를 때 묽은 우유가 먼저 나오고 거품이 피처에 덩어리로 남는다면, 우유와 거품이 덜 섞인 거예요. 다음엔 공기를 넣은 뒤 노즐 끝을 살짝 담가 우유 전체가 돌도록 해 보세요."
          }
        }
      }
    },
    "큰 기포 주의": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch for large bubbles"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큰 기포 주의"
          }
        }
      }
    },
    "큰 기포가 눈에 띄나요?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can you see large bubbles?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큰 기포가 눈에 띄나요?"
          }
        }
      }
    },
    "큰 기포가 생길 수 있어요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large bubbles may form"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큰 기포가 생길 수 있어요"
          }
        }
      }
    },
    "큰 기포가 섞인 거품층이\n위에 남았을 수 있어요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A layer of bubbly foam\nmay have stayed on top"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큰 기포가 섞인 거품층이\n위에 남았을 수 있어요"
          }
        }
      }
    },
    "큰 기포와 거품 두께를 구분해 보세요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check large bubbles and foam thickness separately"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큰 기포와 거품 두께를 구분해 보세요"
          }
        }
      }
    },
    "표면과 따를 때의 모습을 함께 보세요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the surface and how the milk pours"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표면과 따를 때의 모습을 함께 보세요"
          }
        }
      }
    },
    "표면에 큰 기포가 남았나요?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are large bubbles left on the surface?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표면에 큰 기포가 남았나요?"
          }
        }
      }
    },
    "표면에 큰 기포가 있는지 먼저 살펴보세요. 컵에 따를 때 묽은 우유가 먼저 나오고 거품이 피처에 덩어리로 남는다면 우유와 거품이 고르게 섞이지 않은 상태예요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First check the surface for large bubbles. If thin milk pours first and clumps of foam stay in the pitcher, the milk and foam haven't mixed evenly."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표면에 큰 기포가 있는지 먼저 살펴보세요. 컵에 따를 때 묽은 우유가 먼저 나오고 거품이 피처에 덩어리로 남는다면 우유와 거품이 고르게 섞이지 않은 상태예요."
          }
        }
      }
    },
    "표면이 전반적으로 매끈한지, 그 사이에 큰 기포가 남았는지 보세요. 몇 개만 남았다면 피처 바닥을 작업대에 가볍게 톡톡 두드린 뒤 살짝 돌려 보세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check whether the surface is mostly smooth or has large bubbles. If only a few remain, gently tap the pitcher on the counter, then swirl it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표면이 전반적으로 매끈한지, 그 사이에 큰 기포가 남았는지 보세요. 몇 개만 남았다면 피처 바닥을 작업대에 가볍게 톡톡 두드린 뒤 살짝 돌려 보세요."
          }
        }
      }
    },
    "피처 안을 들여다봤을 때 낱개로 또렷이 보이는 기포가 있는지 살펴보세요. 큰 기포가 남았다면 다음엔 공기를 넣을 때 노즐 끝이 표면 밖으로 드러나지 않게 해 보세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look inside the pitcher for individual, clearly visible bubbles. If large bubbles remain, try keeping the tip just below the surface while adding air next time."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피처 안을 들여다봤을 때 낱개로 또렷이 보이는 기포가 있는지 살펴보세요. 큰 기포가 남았다면 다음엔 공기를 넣을 때 노즐 끝이 표면 밖으로 드러나지 않게 해 보세요."
          }
        }
      }
    },
    "피처를\n내려 주세요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower the\npitcher"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피처를\n내려 주세요"
          }
        }
      }
    },
    "피처를\n올려 주세요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raise the\npitcher"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피처를\n올려 주세요"
          }
        }
      }
    },
    "피처를 가볍게 돌려 우유 표면을 보세요. 기포 하나하나가 잘 보이지 않고 표면이 매끈하게 빛나면 고운 거품의 특징이에요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gently swirl the pitcher and look at the milk's surface. A smooth, glossy surface with barely visible individual bubbles is a sign of fine foam."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피처를 가볍게 돌려 우유 표면을 보세요. 기포 하나하나가 잘 보이지 않고 표면이 매끈하게 빛나면 고운 거품의 특징이에요."
          }
        }
      }
    },
    "피처를 살짝\n내려 주세요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower the pitcher\nslightly"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피처를 살짝\n내려 주세요"
          }
        }
      }
    },
    "피처를 살짝 올려\n노즐을 더 담가 주세요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raise the pitcher\nto submerge the tip"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피처를 살짝 올려\n노즐을 더 담가 주세요"
          }
        }
      }
    },
    "피처에 처음 담았을 때보다 우유가 얼마나 부풀었는지 보세요. 높이가 거의 그대로이고 거품도 적다면 다음번엔 공기를 조금 더 오래 넣어 보세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check how much the milk has expanded from its starting level. If the level has barely changed and there's little foam, try adding air a little longer next time."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피처에 처음 담았을 때보다 우유가 얼마나 부풀었는지 보세요. 높이가 거의 그대로이고 거품도 적다면 다음번엔 공기를 조금 더 오래 넣어 보세요."
          }
        }
      }
    },
    "피처에서는 표면에 큰 기포가 남았는지, 컵에 따른 뒤 거품이 원하는 두께인지 보세요. 큰 기포가 남았다면 다음엔 공기를 한꺼번에 넣지 않도록 노즐 끝을 표면 바로 아래에 두세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look for large bubbles in the pitcher, then check the foam's thickness after pouring. If large bubbles remain, keep the tip just below the surface next time so air doesn't rush in all at once."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피처에서는 표면에 큰 기포가 남았는지, 컵에 따른 뒤 거품이 원하는 두께인지 보세요. 큰 기포가 남았다면 다음엔 공기를 한꺼번에 넣지 않도록 노즐 끝을 표면 바로 아래에 두세요."
          }
        }
      }
    },
    "한 잔의 시작, 작은 소리부터 함께해요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every great cup starts with a little sound."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 잔의 시작, 작은 소리부터 함께해요"
          }
        }
      }
    },
