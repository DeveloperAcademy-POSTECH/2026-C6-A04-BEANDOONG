    "32kHz 이상의 고정된 마이크 입력이 필요해요. 입력 장치를 확인해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A stable microphone input of at least 32 kHz is required. Please check your input device."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "32kHz 이상의 고정된 마이크 입력이 필요해요. 입력 장치를 확인해 주세요."
          }
        }
      }
    },
    "Apple Watch\n연결이 끊겼어요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch\ndisconnected"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch\n연결이 끊겼어요"
          }
        }
      }
    },
    "Apple Watch 가\n준비되었어요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple Watch\nis ready"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch 가\n준비되었어요"
          }
        }
      }
    },
    "Apple Watch 를\n찾지 못했어요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch\nnot found"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch 를\n찾지 못했어요"
          }
        }
      }
    },
    "Apple Watch 에\nchic을 설치해주세요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install chic on\nyour Apple Watch"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch 에\nchic을 설치해주세요"
          }
        }
      }
    },
    "Apple Watch 연결을\n확인하고 있어요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking your\nApple Watch connection"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch 연결을\n확인하고 있어요"
          }
        }
      }
    },
    "Apple Watch를 함께 사용하면\n상태 변화를 진동으로도 안내받을 수 있어요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Apple Watch, you can also\nfeel changes through haptic feedback."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch를 함께 사용하면\n상태 변화를 진동으로도 안내받을 수 있어요"
          }
        }
      }
    },
    "Apple Watch에서 chic 앱을 열어주세요\n손목 진동으로 스팀 상태를 알려드려요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open chic on your Apple Watch.\nFeel steaming updates on your wrist."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch에서 chic 앱을 열어주세요\n손목 진동으로 스팀 상태를 알려드려요"
          }
        }
      }
    },
    "Apple Watch에서 chic 앱을 열어주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please open chic on your Apple Watch."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch에서 chic 앱을 열어주세요."
          }
        }
      }
    },
