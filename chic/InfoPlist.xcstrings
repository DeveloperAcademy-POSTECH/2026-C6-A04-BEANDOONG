      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "chic uses the microphone to analyze milk steaming sounds and tell you your steaming status in real time."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "우유 스티밍 소리를 분석해 스티밍 상태를 실시간으로 알려드리기 위해 마이크를 사용합니다."
          }
        }
      }
