    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "chic uses the microphone to analyze milk steaming sounds in real time and provide practice feedback."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우유 스티밍 소리를 실시간으로 분석해 연습 피드백을 제공하기 위해 마이크를 사용합니다."
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "chic uses device motion to animate light reflections on the app icon in Settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰 기울기에 따라 설정 화면 앱 아이콘의 빛 반사 효과를 표현합니다."
          }
        }
      }
    }
  },
  "version": "1.0"
